<Application x:Class="MarklifeWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:local="clr-namespace:MarklifeWin">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#1976D2"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="ConnectedBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="DisconnectedBrush" Color="#F44336"/>
            
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <local:ScanButtonTextConverter x:Key="ScanButtonTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
