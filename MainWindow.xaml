<Window x:Class="MarklifeWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки принтера"
        Height="560" Width="420"
        Icon="Resources/main.ico"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Window button style -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width"        Value="40"/>
            <Setter Property="Height"       Value="28"/>
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"   Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0,10,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small action button -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Padding"          Value="8,4"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Background"       Value="#2196F3"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Disconnect button -->
        <Style x:Key="DisconnectBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Scan button -->
        <Style x:Key="ScanBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <!-- Param row label -->
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Param row value -->
        <Style x:Key="ParamValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#E8E8E8" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="DragWindow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Настройки принтера"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0"/>
                    <Button Grid.Column="1" Content="&#xE8BB;"
                            Click="CloseWindow" Style="{StaticResource WinBtn}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Устройства"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource ScanBtn}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                            Click="Scan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IsScanning, Converter={StaticResource ScanButtonTextConverter}}"
                                       VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Margin="6,0,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Fill" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Device list -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4,6">
                    <ListBox BorderThickness="0" ItemsSource="{Binding Devices}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" CornerRadius="6"
                                        Padding="10,8" Margin="3,3">
                                    <StackPanel>
                                        <!-- Device header row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="10" Foreground="Gray"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <!-- Connect / Disconnect button — no BasedOn inside DataTemplate -->
                                            <Button Grid.Column="1"
                                                    IsEnabled="{Binding IsConnectEnabled}"
                                                    Content="{Binding ButtonText}"
                                                    Tag="{Binding Id}"
                                                    Click="DeviceCnnectButton_Click"
                                                    VerticalAlignment="Center"
                                                    Padding="8,4" FontSize="11" Cursor="Hand"
                                                    Foreground="White" BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#2196F3"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Background" Value="#F44336"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#BDBDBD"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- Device params (visible when connected) -->
                                        <StackPanel Visibility="{Binding HasParams}" Margin="0,8,0,0">

                                            <!-- Section title -->
                                            <TextBlock Text="Параметры устройства"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#444" Margin="0,0,0,6"/>

                                            <!-- Battery -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Заряд батареи:"
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Battery}"
                                                           FontSize="11" Foreground="#222" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Paper -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Остаток бумаги:"
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Paper}"
                                                           FontSize="11" Foreground="#222" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Firmware -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Прошивка:"
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Firmware}"
                                                           FontSize="11" Foreground="#222" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Serial -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Серийный номер:"
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Serial}"
                                                           FontSize="11" Foreground="#222" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- MAC -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MAC адрес:"
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Mac}"
                                                           FontSize="11" Foreground="#222" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Auto-shutdown dropdown -->
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Автоотключение:"
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                                <!-- Прочерк пока значение не получено -->
                                                <TextBlock Grid.Column="1" Text="—"
                                                           FontSize="11" Foreground="#999" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShutdownKnown}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Комбобокс появляется после получения значения -->
                                                <ComboBox Grid.Column="1"
                                                          Width="90" FontSize="11"
                                                          IsEnabled="{Binding IsParamsButton}"
                                                          SelectedIndex="{Binding ShutdownSelectedIndex, Mode=OneWay}"
                                                          SelectionChanged="ShutdownCombo_SelectionChanged"
                                                          Tag="{Binding}">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShutdownKnown}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                    <ComboBoxItem>5 мин</ComboBoxItem>
                                                    <ComboBoxItem>10 мин</ComboBoxItem>
                                                    <ComboBoxItem>15 мин</ComboBoxItem>
                                                    <ComboBoxItem>30 мин</ComboBoxItem>
                                                    <ComboBoxItem>60 мин</ComboBoxItem>
                                                </ComboBox>
                                            </Grid>

                                            <!-- Auto-reconnect toggle + Refresh button -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Content="Автоподключение"
                                                          FontSize="11"
                                                          IsChecked="{Binding AutoReconnect, Mode=TwoWay}"
                                                          Tag="{Binding}"
                                                          Click="AutoReconnectToggle_Click"
                                                          VerticalAlignment="Center"/>
                                                <Button Grid.Column="2"
                                                        IsEnabled="{Binding IsParamsButton}"
                                                        Content="{Binding ParamsButtonText}"
                                                        Tag="{Binding Id}"
                                                        Click="GetParamsButton_Click"
                                                        Padding="8,4" FontSize="11" Cursor="Hand"
                                                        Foreground="White" BorderThickness="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#2196F3"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="#BDBDBD"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
