<Window x:Class="MarklifeWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки принтера"
        Height="550"
        Width="450"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <SolidColorBrush x:Key="ConnectedBrush"
                         Color="#4CAF50"/>
        <SolidColorBrush x:Key="DisconnectedBrush"
                         Color="#F44336"/>
        <Style x:Key="WindowButtonStyle"
               TargetType="Button"
               BasedOn="{x:Null}">
            <Setter Property="Width"
                    Value="46"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontFamily"
                    Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"
                    Value="10"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E67E22"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseWindowButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0,10,0,0"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E81123"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="#F5F5F5"
            CornerRadius="10"
            RenderOptions.BitmapScalingMode="HighQuality"
            UseLayoutRounding="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="#E5E5E5"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="DragWindow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center"
                               Margin="12,0"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="&#xE8BB;"
                                Click="CloseWindow"
                                Style="{StaticResource CloseWindowButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <Grid Grid.Row="1"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок с кнопкой сканирования -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Устройства"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                            Padding="15,8"
                            Click="Scan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IsScanning, Converter={StaticResource ScanButtonTextConverter}}"
                                       VerticalAlignment="Center"/>
                            <Ellipse x:Name="ScanIndicator"
                                     Width="12"
                                     Height="12"
                                     Margin="8,0,0,0"
                                     Visibility="Collapsed">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="#2196F3"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Setter Property="Fill"
                                                        Value="#2196F3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                                From="#2196F3"
                                                                To="#64B5F6"
                                                                Duration="0:0:0.5"
                                                                AutoReverse="True"
                                                                RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Список устройств -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="8"
                        Padding="5,10">
                    <ListBox x:Name="DeviceList"
                             BorderThickness="0"
                             ItemsSource="{Binding Devices}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="Padding"
                                        Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA"
                                        CornerRadius="6"
                                        Padding="12,12,6,12"
                                        Margin="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           Foreground="Gray"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    IsEnabled="{Binding IsConnectEnabled}"
                                                    Content="{Binding ButtonText}"
                                                    Padding="8"
                                                    VerticalAlignment="Center"
                                                    Click="DeviceCnnectButton_Click"
                                                    Tag="{Binding Id}"/>
                                        </Grid>

                                        <StackPanel Grid.Row="1"
                                                x:Name="DeviceParams"
                                                    Visibility="{Binding HasParams}"
                                                    Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Заряд батареи:"
                                                           FontSize="11"
                                                           Foreground="#666"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Battery}"
                                                           FontSize="12"
                                                           Foreground="#000"/>
                                            </Grid>
                                             <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Остаток бумаги:"
                                                           FontSize="11"
                                                           Foreground="#666"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Paper}"
                                                           FontSize="12"
                                                           Foreground="#000"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Серийный номер:"
                                                           FontSize="11"
                                                           Foreground="#666"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Serial}"
                                                           FontSize="12"
                                                           Foreground="#000"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MAC адрес:"
                                                           FontSize="11"
                                                           Foreground="#666"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Mac}"
                                                           FontSize="12"
                                                           Foreground="#000"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Автоотключение:"
                                                           FontSize="11"
                                                           Foreground="#666"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Shutdown}"
                                                           FontSize="12"
                                                           Foreground="#000"/>
                                            </Grid>
                                             <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" 
                                                    IsEnabled="{Binding IsParamsButton}"
                                                    Content="{Binding ParamsButtonText}"
                                                    Padding="8"
                                                    VerticalAlignment="Center"
                                                    Click="GetParamsButton_Click"
                                                    Tag="{Binding Id}"/>
                                                <TextBlock Grid.Column="1" Text="Автоподключение: отключено"
                                                           FontSize="12"
                                                           Foreground="#000"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>