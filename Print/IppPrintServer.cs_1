        private void ImproveRawResponse(IIppRequest request, IIppResponseMessage rawResponse)
        {
            switch (request)
            {
                case GetPrinterAttributesRequest x:
                    ImproveGetPrinterAttributesRawResponse(x, rawResponse);
                    break;
            }
        }

